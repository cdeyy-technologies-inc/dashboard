# Jest runs with NODE_ENV=test, and Next.js deliberately skips loading .env.local in that environment (it only reads .env.test.local, .env.test, then .env).
# so we need this file to mirror .env.local for tests.
# we need .env.local for local development, and .env.test for tests.
# Database (Docker Compose)
POSTGRES_URL=postgres://nextjs:nextjs@localhost:5432/nextjs
POSTGRES_USER=nextjs
POSTGRES_HOST=localhost
POSTGRES_SSL=false

POSTGRES_PRISMA_URL=postgres://nextjs:nextjs@localhost:5432/nextjs
POSTGRES_URL_NON_POOLING=postgres://nextjs:nextjs@localhost:5432/nextjs

POSTGRES_PASSWORD=nextjs
POSTGRES_DATABASE=nextjs

# Auth
# `openssl rand -base64 32`
AUTH_SECRET=toyP2UtxhwgGGPUW7KgObfNKqioXgXiNLrci3c/hCEw=
AUTH_URL=http://localhost:3000/api/auth
